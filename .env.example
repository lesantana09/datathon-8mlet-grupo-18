# Copie para `.env` e ajuste os valores para o seu ambiente (`.env` não é
# versionado). Sem isso, os defaults abaixo assumem execução local via
# docker-compose.
# API
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8081
API_V1_STR=/api/v1
WEB_CONCURRENCY=1
API_USERNAME = "user"
API_PASSWORD = "super_secret_password"
# MLFOW
DAGSHUB_APP_TOKEN = "super_secret_token"
MLFLOW_TRACKING_URI = "https://dagshub.com/lesantana09/datathon-8mlet-grupo-18.mlflow"
MLFLOW_EXPERIMENT_NAME = "channel_recommendation_policy"
MLFLOW_TRACKING_USERNAME = "tramontano"
# AWS
BUCKET_NAME = "datathon-8mlet-grupo-18"
AWS_REGION = "us-east-1"
AWS_ENDPOINT_URL = "https://dagshub.com/api/v1/repo-buckets/s3/lesantana09"
AWS_ACCESS_KEY = "super_access_key"
AWS_SECRET_KEY = "super_secret_key"
# Grafana
GF_SECURITY_ADMIN_USER = "user"
GF_SECURITY_ADMIN_PASSWORD = "super_secret_password"
GF_AUTH_ANONYMOUS_ENABLED=true
