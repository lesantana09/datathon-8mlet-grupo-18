# Copie para `.env` e ajuste os valores para o seu ambiente (`.env` não é
# versionado). Sem isso, os defaults abaixo assumem execução local via
# docker-compose.

# URL do servidor MLflow (Etapa 7). Local: docker-compose expõe em
# localhost:5000. Em outro ambiente (ex. AWS, Etapa 6), aponte para o
# endpoint do serviço MLflow lá.
MLFLOW_TRACKING_URI=http://localhost:5000
