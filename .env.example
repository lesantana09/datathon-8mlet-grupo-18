# Copie para `.env` e ajuste os valores para o seu ambiente (`.env` não é
# versionado). Sem isso, os defaults abaixo assumem execução local via
# docker-compose.
DAGSHUB_APP_TOKEN = "super_secret_token"
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME = "channel_recommendation_policy"
MLFLOW_TRACKING_USERNAME = "tramontano"
AWS_REGION = "us-east-1"
AWS_ENDPOINT_URL = "https://s3.amazon.com"
AWS_ACCESS_KEY = "super_access_key"
AWS_SECRET_KEY = "super_secret_key"
API_USERNAME = "user"
API_PASSWORD = "super_secret_password"
